# ==========================================
# StudyAbroad Vista - Environment Configuration
# ==========================================

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------
# Supabase (PostgreSQL, pgvector, Auth, Storage)
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
# Modern Supabase Publishable Key (replaces legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"
# Modern Supabase Secret Key (replaces legacy service_role key)
SUPABASE_SECRET_KEY="your-secret-key-here"
# Legacy fallbacks (optional)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------
# Google Gemini AI (LLM & Embeddings)
# ------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
# Primary model for AI Counsellor
GEMINI_MODEL="gemini-1.5-flash"
# Embedding model for pgvector RAG
GEMINI_EMBEDDING_MODEL="text-embedding-004"

# ------------------------------------------
# Sanity.io (Headless CMS for Articles & Guides)
# ------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="your-sanity-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-01-01"
SANITY_API_READ_TOKEN="your-sanity-read-token"

# ------------------------------------------
# Razorpay (India B2B Wallet & Payments)
# ------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# ------------------------------------------
# Communications & Verification
# ------------------------------------------
# MSG91 for Indian mobile SMS OTP
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_OTP_TEMPLATE_ID="your_otp_template_id"

# Resend for Transactional Email
RESEND_API_KEY="re_your_resend_api_key"

# WhatsApp Cloud API (Optional for MVP)

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""